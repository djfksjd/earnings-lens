# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해 .env 를 만드세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다.
# 값 앞뒤에 따옴표·공백 없이 붙여 넣으세요. 모든 항목은 선택입니다.
# ─────────────────────────────────────────────────────────────

# [권장·무료·키 아님] SEC EDGAR 접속용 연락처 "이름 이메일" (미국 8-K 보도자료, 10-Q 사업부문 자동 채움, yfinance 빈 분기 보완)
SEC_USER_AGENT=

# [권장·무료] Alpha Vantage — 미국 컨콜 트랜스크립트 (하루 25회)
ALPHAVANTAGE_API_KEY=

# [한국 종목 권장·무료] OpenDART — 공식 분기 재무제표·공시
DART_API_KEY=

# [선택·무료] Finnhub — 미국 실시간 시세 (없으면 yfinance)
FINNHUB_API_KEY=

# [한국 종목 권장·무료] KRX Open API — 공식 일별 시세. yfinance가 빠뜨린 종가(장 마감 동시호가)·지수 일봉을 채움
# 키 발급 후 openapi.krx.co.kr에서 서비스별 '이용신청' 승인이 따로 필요합니다(약 1일):
#   유가증권 일별매매정보, 코스닥 일별매매정보, KOSPI 시리즈 일별시세정보, KOSDAQ 시리즈 일별시세정보
KRX_OPEN_API_KEY=

# [선택] 네이버 증권 룰베이스 수집 — 한국 실시간 시세·분기 컨센서스(E)
# 네이버 robots.txt 가 자동 수집을 막고 있습니다. 개인 학습 용도로만, 본인 판단으로 켜세요.
NAVER_SCRAPING_ENABLED=false

# [선택] 미국 룰베이스 수집 — robots.txt는 허용하지만 두 사이트 모두 이용약관이 자동 수집을 금지합니다.
# 개인 학습 용도로만, 본인 판단으로 켜세요. 종목당 하루 1회(MarketBeat), 버튼 1회당 1건(Fool)만 호출하고 캐시합니다.
# MarketBeat: 과거 분기 매출·EPS 컨센서스 / Motley Fool: 컨콜 원문
MARKETBEAT_SCRAPING_ENABLED=false
FOOL_SCRAPING_ENABLED=false

# AI (Claude 구독 플랜, Claude Code CLI 사용 — API 키 필요 없음)
AI_ENABLED=true
CLAUDE_MODEL=sonnet
# CLAUDE_BIN=/full/path/to/claude   # claude 명령을 못 찾을 때만

# 가격 새로고침 간격(초, 최소 10)
PRICE_REFRESH_SECONDS=30
